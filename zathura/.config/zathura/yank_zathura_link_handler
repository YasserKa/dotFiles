#!/usr/bin/env bash

# Open a document to a page or using its name
# Dependencies: fd

# [[doc:<file_name>::<page_num>][file_name, page <page_num>]]
file_path="$1"
page_num="$2"
section_name="$3"

doc_basename="${file_path##*/}"
doc_name="${doc_basename%.*}"
description="$doc_name"

link="${doc_basename}"

if [[ $page_num ]]; then
	link="${link}::${page_num}"
	if [[ $section_name ]]; then
		description+=", $section_name"
	else
		description+=", page $page_num"
	fi
fi

org_url="[[doc:${link}][${description}]]"

clipboard_copy "$org_url"
