#!/usr/bin/env python3

"""Add/Undo/Remove/Yank annotated text"""

# pyright: ignore [reportGeneralTypeIssues]

import os
import subprocess
import sys
import re
from typing import List, Tuple

import pymupdf
import pyperclip as pc

# Fraction of a word's height that must lie inside the highlight
# for the word to count as highlighted
MIN_VERTICAL_OVERLAP = 0.6
FILE_PATH = sys.argv[2]

# Highlight colors, chosen by number: `add FILE PAGE 3`
HIGHLIGHT_COLORS = {
    "1": "#87CFFA",  # blue
    "2": "#FFEB3B",  # yellow
    "3": "#8FED8F",  # green
    "4": "#FF99CC",  # pink
    "5": "#FFA64D",  # orange
}
DEFAULT_COLOR = "1"

# One line per highlight made with `add`: <file>\t<page index>\t<annot xref>
UNDO_LOG = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "zathura_highlights.log",
)


def main():
    if sys.argv[1] == "add":
        color = sys.argv[4] if len(sys.argv) > 4 else DEFAULT_COLOR
        add_highlight(int(sys.argv[3]), color)
    elif sys.argv[1] == "undo":
        undo_highlight()
    elif sys.argv[1] == "get_annotations":
        print("\n".join(get_highlights()))
    elif sys.argv[1] == "yank_annotations":
        pc.copy("\n".join(get_highlights()))
        subprocess.run(["dunstify", "Copied to clipboard"])
    elif sys.argv[1] == "remove_annotations":
        print("removing")
        remove_annotations()
    elif sys.argv[1] == "yank_chapters_as_tasks":
        print("Yanking chapters as tasks")
        yank_chapters_as_tasks()
    elif sys.argv[1] == "yank_section":
        print("Getting section")
        yank_section_name_of_page(int(sys.argv[3]))
    else:
        raise ValueError


def hex_to_rgb(hex_color: str) -> Tuple[float, float, float]:
    h = hex_color.lstrip("#")
    return tuple(int(h[i : i + 2], 16) / 255 for i in (0, 2, 4))


def save_incremental(doc):
    doc.save(FILE_PATH, encryption=pymupdf.PDF_ENCRYPT_KEEP, incremental=True)


def read_undo_log() -> List[str]:
    try:
        with open(UNDO_LOG) as f:
            return f.read().splitlines()
    except FileNotFoundError:
        return []


def write_undo_log(lines: List[str]):
    os.makedirs(os.path.dirname(UNDO_LOG), exist_ok=True)
    with open(UNDO_LOG, "w") as f:
        f.write("".join(line + "\n" for line in lines))


def add_highlight(page_num: int, color: str):
    """Highlight the clipboard selection on page_num (1-based) and log it for undo"""
    text = pc.paste().strip()
    if not text:
        return
    doc = pymupdf.open(FILE_PATH)
    page = doc[page_num - 1]
    hits = page.search_for(text, quads=True)
    if not hits:
        subprocess.run(["dunstify", "Selection not found on page"])
        return
    annot = page.add_highlight_annot(hits)
    annot.set_colors(
        stroke=hex_to_rgb(HIGHLIGHT_COLORS.get(color, HIGHLIGHT_COLORS[DEFAULT_COLOR]))
    )
    annot.update()
    xref = annot.xref
    save_incremental(doc)
    lines = read_undo_log()
    lines.append(f"{os.path.realpath(FILE_PATH)}\t{page_num - 1}\t{xref}")
    write_undo_log(lines)


def undo_highlight():
    """Remove the most recent highlight made with `add` in this file"""
    path = os.path.realpath(FILE_PATH)
    lines = read_undo_log()
    for i in range(len(lines) - 1, -1, -1):
        file, page_index, xref = lines[i].split("\t")
        if file != path:
            continue
        doc = pymupdf.open(FILE_PATH)
        page = doc[
            int(page_index)
        ]  # keep the page alive, else "Annot is not bound to a page"
        annot = page.load_annot(int(xref))
        if annot:  # may already have been removed elsewhere
            page.delete_annot(annot)
            save_incremental(doc)
        del lines[i]
        write_undo_log(lines)
        return


def word_in_rect(word_rect: pymupdf.Rect, hl_rect: pymupdf.Rect) -> bool:
    if word_rect.x1 <= hl_rect.x0 or word_rect.x0 >= hl_rect.x1:
        return False  # no horizontal overlap
    overlap = min(word_rect.y1, hl_rect.y1) - max(word_rect.y0, hl_rect.y0)
    return overlap >= MIN_VERTICAL_OVERLAP * word_rect.height


def parse_highlight(annot: pymupdf.Annot, wordlist) -> str:
    points = annot.vertices
    lines = []
    for i in range(len(points) // 4):  # one quad per highlighted line
        r = pymupdf.Quad(points[i * 4 : i * 4 + 4]).rect
        words = [w[4] for w in wordlist if word_in_rect(pymupdf.Rect(w[:4]), r)]
        lines.append(" ".join(words))
    return " ".join(lines)


def norm(s: str) -> str:
    # Remove spaces, punctuation and line-break hyphens, and ignore case
    return re.sub(r"\W+", "", s).lower()


def is_two_column(page) -> bool:
    mid = page.rect.width / 2
    blocks = [b for b in page.get_text("blocks") if b[6] == 0]  # text blocks only
    left = sum(1 for b in blocks if b[2] < mid)  # entirely left of middle
    right = sum(1 for b in blocks if b[0] > mid)  # entirely right of middle
    crossing = len(blocks) - left - right  # spans the middle
    return left >= 2 and right >= 2 and left + right > crossing


def annot_position(annot: pymupdf.Annot, two_column: bool) -> tuple[int, float, float]:
    r = pymupdf.Quad(annot.vertices[:4]).rect if annot.vertices else annot.rect
    column = 1 if two_column and r.x0 >= annot.parent.rect.width / 2 else 0
    return (column, round(r.y0), r.x0)


def handle_page(page) -> List[str]:
    wordlist = page.get_text("words", sort=True)

    two_column = is_two_column(page)
    annots = sorted(
        page.annots(types=[pymupdf.PDF_ANNOT_HIGHLIGHT]),
        key=lambda a: annot_position(a, two_column),
    )

    highlights = []
    for annot in annots:
        text = parse_highlight(annot, wordlist)
        note = (annot.info.get("content") or "").strip()

        if not text:
            highlights.append(note)
        else:
            highlights.append(text)
            if note and norm(note) not in norm(text):
                highlights.append(f" {note} ")
    return highlights


def get_highlights() -> List[str]:
    doc = pymupdf.open(FILE_PATH)
    highlights = []
    for page in doc:
        highlights += handle_page(page)
    return highlights


def yank_section_name_of_page(page_num: int):
    """Get the section name of the highlighted text

    Args:
        page_num: page number
        text: selected text
    """
    doc = pymupdf.open(FILE_PATH)
    text = pc.paste()

    toc = doc.get_toc()
    section_name = ""
    for index, section in enumerate(toc):
        curr_section = section
        curr_index = index
        # Get the section that's after this page
        if page_num < curr_section[2]:
            page_text = doc.get_page_text(page_num - 1, flags=0)
            # Get the current section (could be in current page or before)
            curr_section = toc[curr_index - 1]
            section_name = curr_section[1]

            # If the section in current page, check if text is after the section
            while page_num == curr_section[2]:
                # Pages index start from 0 in this method
                section_name = curr_section[1]
                # If text is below the section, use it
                if page_text.rfind(text) > page_text.rfind(section_name):
                    break
                else:
                    curr_index = curr_index - 1
                    curr_section = toc[curr_index - 1]
                    section_name = curr_section[1]
            break
    subprocess.run(
        [
            "/home/yasser/.config/zathura/yank_zathura_link_handler",
            FILE_PATH,
            str(page_num),
            section_name,
        ]
    )


def yank_chapters_as_tasks():
    """Yank chapters as Org tasks in the following format
    ** TODO Read <chapter name> chapter (<chapter index>)

    Args:
        file_path: path fo file
    """
    from urllib.parse import quote
    from pathlib import Path

    doc = pymupdf.open(FILE_PATH)
    toc = doc.get_toc()

    file_name = Path(FILE_PATH).name

    chapters = filter(lambda x: x[0] == 1, toc)
    tasks = ""
    for index, chapter in enumerate(chapters):
        encoded_command = quote(f'open_document "{file_name}" {chapter[2]}', safe="")
        link_name = f"{file_name}, page {chapter[2]}"
        org_url = f"[[link-handler://{encoded_command}][{link_name}]]"
        tasks += f"** TODO Read {chapter[1]} chapter ({index})\n{org_url}\n"

    pc.copy(tasks)


def remove_annotations():
    doc = pymupdf.open(FILE_PATH)
    for page in doc:
        annot = page.first_annot
        while annot:
            # Need to store the annotation before deleting it, else pymupdf raises an error for Annot not being boudn to a page
            next_annot = annot.next
            page.delete_annot(annot)
            annot = next_annot
    save_incremental(doc)
    # Nothing left to undo in this file
    path = os.path.realpath(FILE_PATH)
    write_undo_log([l for l in read_undo_log() if l.split("\t")[0] != path])


if __name__ == "__main__":
    main()
