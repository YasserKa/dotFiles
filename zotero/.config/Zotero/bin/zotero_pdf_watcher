#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "watchdog",
# ]
# ///

from __future__ import annotations

import argparse
import hashlib
import json
import logging
import os
import shutil
import signal
import tempfile
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

from watchdog.events import FileSystemEventHandler
from watchdog.observers import Observer

LOG = logging.getLogger("zotero-pdf-watcher")


@dataclass(frozen=True)
class Mapping:
    attachment_key: str
    source: Path
    destinations: tuple[Path, ...]


class ManifestIndex:
    """
    Reads .zotero-mirror-manifest.json generated by the Zotero extension.

    Builds indexes in both directions:

        Zotero source PDF -> Mapping
        Mirror PDF        -> Mapping
    """

    def __init__(self, manifest_path: Path):
        self.manifest_path = manifest_path
        self._mtime_ns: Optional[int] = None
        self.by_source: dict[Path, Mapping] = {}
        self.by_destination: dict[Path, Mapping] = {}
        self.lock = threading.RLock()

    def reload_if_needed(self, force=False) -> bool:
        try:
            stat = self.manifest_path.stat()
        except FileNotFoundError:
            LOG.warning("Manifest does not exist: %s", self.manifest_path)
            return False

        if not force and self._mtime_ns == stat.st_mtime_ns:
            return False

        # Zotero extension may be replacing/writing the manifest.
        # Retry briefly rather than treating a transient partial write as valid.
        data = None

        for attempt in range(5):
            try:
                with self.manifest_path.open("r", encoding="utf-8") as f:
                    data = json.load(f)
                break
            except (json.JSONDecodeError, OSError) as exc:
                if attempt == 4:
                    LOG.error("Could not read manifest: %s", exc)
                    return False
                time.sleep(0.2)

        entries = data.get("entries", {})

        grouped: dict[tuple[str, Path], set[Path]] = {}

        for dest_path, entry in entries.items():
            source_raw = entry.get("sourcePath")
            if not source_raw:
                continue

            source = normalize(Path(source_raw))
            destination = normalize(Path(entry.get("destPath", dest_path)))

            attachment_key = str(
                entry.get("attachmentKey") or entry.get("attachmentID") or source
            )

            key = (attachment_key, source)
            grouped.setdefault(key, set()).add(destination)

        by_source: dict[Path, Mapping] = {}
        by_destination: dict[Path, Mapping] = {}

        for (attachment_key, source), destinations in grouped.items():
            mapping = Mapping(
                attachment_key=attachment_key,
                source=source,
                destinations=tuple(sorted(destinations)),
            )

            by_source[source] = mapping

            for destination in mapping.destinations:
                by_destination[destination] = mapping

        with self.lock:
            self.by_source = by_source
            self.by_destination = by_destination
            self._mtime_ns = stat.st_mtime_ns

        LOG.info(
            "Loaded manifest: %d attachments, %d mirror files",
            len(by_source),
            len(by_destination),
        )

        return True

    def from_source(self, path: Path) -> Optional[Mapping]:
        self.reload_if_needed()

        with self.lock:
            return self.by_source.get(normalize(path))

    def from_destination(self, path: Path) -> Optional[Mapping]:
        self.reload_if_needed()

        with self.lock:
            return self.by_destination.get(normalize(path))


class SyncState:
    """
    Stores the last content hash known to have been synchronized for each
    Zotero attachment.

    This lets us distinguish:

        mirror changed
        source changed
        both changed
    """

    def __init__(self, path: Path):
        self.path = path
        self.lock = threading.RLock()
        self.hashes: dict[str, str] = {}
        self.load()

    def load(self):
        try:
            with self.path.open("r", encoding="utf-8") as f:
                data = json.load(f)
                self.hashes = data.get("attachments", {})
        except FileNotFoundError:
            self.hashes = {}
        except Exception:
            LOG.exception("Could not load state file")
            self.hashes = {}

    def get(self, attachment_key: str) -> Optional[str]:
        with self.lock:
            return self.hashes.get(attachment_key)

    def set(self, attachment_key: str, digest: str):
        with self.lock:
            self.hashes[attachment_key] = digest
            self._save()

    def _save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)

        data = {
            "version": 1,
            "updatedAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "attachments": self.hashes,
        }

        atomic_write_json(self.path, data)


class Debouncer:
    def __init__(self, delay: float, callback):
        self.delay = delay
        self.callback = callback
        self.lock = threading.Lock()
        self.timers: dict[Path, threading.Timer] = {}

    def submit(self, path: Path):
        path = normalize(path)

        with self.lock:
            old = self.timers.pop(path, None)

            if old:
                old.cancel()

            timer = threading.Timer(
                self.delay,
                self._run,
                args=(path,),
            )
            timer.daemon = True
            self.timers[path] = timer
            timer.start()

    def _run(self, path: Path):
        with self.lock:
            self.timers.pop(path, None)

        try:
            self.callback(path)
        except Exception:
            LOG.exception("Unhandled error processing %s", path)


class PDFEventHandler(FileSystemEventHandler):
    def __init__(self, debouncer: Debouncer):
        self.debouncer = debouncer

    def on_created(self, event):
        self._handle(event)

    def on_modified(self, event):
        self._handle(event)

    def on_moved(self, event):
        if event.is_directory:
            return

        path = Path(event.dest_path)

        if is_pdf(path):
            self.debouncer.submit(path)

    def _handle(self, event):
        if event.is_directory:
            return

        path = Path(event.src_path)

        if is_pdf(path):
            self.debouncer.submit(path)


class ZoteroPDFSync:
    def __init__(
        self,
        manifest: ManifestIndex,
        state: SyncState,
        conflict_dir: Path,
    ):
        self.manifest = manifest
        self.state = state
        self.conflict_dir = conflict_dir

        # One attachment should never be reconciled concurrently from
        # multiple filesystem events.
        self.attachment_locks: dict[str, threading.Lock] = {}
        self.lock = threading.Lock()

    def process(self, changed_path: Path):
        changed_path = normalize(changed_path)

        self.manifest.reload_if_needed()

        mapping = self.manifest.from_source(changed_path)
        changed_side = "source"

        if mapping is None:
            mapping = self.manifest.from_destination(changed_path)
            changed_side = "mirror"

        if mapping is None:
            # Not a PDF represented by the current Zotero manifest.
            return

        attachment_lock = self._get_attachment_lock(mapping.attachment_key)

        with attachment_lock:
            # Give Syncthing/Moon Reader a chance to finish replacing/writing
            # the PDF before hashing it.
            if not wait_until_stable(changed_path):
                LOG.warning(
                    "File did not stabilize: %s",
                    changed_path,
                )
                return

            self._reconcile(
                mapping,
                changed_path,
                changed_side,
            )

    def _reconcile(
        self,
        mapping: Mapping,
        changed_path: Path,
        changed_side: str,
    ):
        source = mapping.source

        if not source.exists():
            LOG.warning(
                "Zotero source does not exist: %s",
                source,
            )
            return

        source_hash = sha256_file(source)
        last_hash = self.state.get(mapping.attachment_key)

        existing_destinations = [p for p in mapping.destinations if p.exists()]

        destination_hashes = {p: sha256_file(p) for p in existing_destinations}

        if changed_side == "source":
            self._source_changed(
                mapping,
                source_hash,
                destination_hashes,
                last_hash,
            )
        else:
            self._mirror_changed(
                mapping,
                changed_path,
                source_hash,
                destination_hashes,
                last_hash,
            )

    def _source_changed(
        self,
        mapping: Mapping,
        source_hash: str,
        destination_hashes: dict[Path, str],
        last_hash: Optional[str],
    ):
        source_changed_since_sync = last_hash is not None and source_hash != last_hash

        independently_changed_mirrors = [
            path
            for path, digest in destination_hashes.items()
            if last_hash is not None and digest != last_hash and digest != source_hash
        ]

        if source_changed_since_sync and independently_changed_mirrors:
            self._conflict(
                mapping,
                mapping.source,
                independently_changed_mirrors[0],
            )
            return

        LOG.info(
            "Zotero -> mirror: %s",
            mapping.source,
        )

        self._propagate(
            mapping.source,
            mapping.destinations,
            source_hash,
        )

        self.state.set(
            mapping.attachment_key,
            source_hash,
        )

    def _mirror_changed(
        self,
        mapping: Mapping,
        changed_mirror: Path,
        source_hash: str,
        destination_hashes: dict[Path, str],
        last_hash: Optional[str],
    ):
        if not changed_mirror.exists():
            return

        mirror_hash = sha256_file(changed_mirror)

        # Nothing actually changed.
        if mirror_hash == source_hash:
            self._propagate(
                changed_mirror,
                mapping.destinations,
                mirror_hash,
            )
            self.state.set(
                mapping.attachment_key,
                mirror_hash,
            )
            return

        if last_hash is not None:
            source_changed = source_hash != last_hash
            mirror_changed = mirror_hash != last_hash

            if source_changed and mirror_changed and source_hash != mirror_hash:
                self._conflict(
                    mapping,
                    mapping.source,
                    changed_mirror,
                )
                return

        LOG.info(
            "Mirror -> Zotero: %s -> %s",
            changed_mirror,
            mapping.source,
        )

        atomic_copy(
            changed_mirror,
            mapping.source,
        )

        # Verify what actually landed.
        new_hash = sha256_file(mapping.source)

        # Propagate the annotated version to every collection containing
        # this attachment.
        self._propagate(
            mapping.source,
            mapping.destinations,
            new_hash,
        )

        self.state.set(
            mapping.attachment_key,
            new_hash,
        )

    def _propagate(
        self,
        authoritative: Path,
        destinations: tuple[Path, ...],
        authoritative_hash: str,
    ):
        for destination in destinations:
            if normalize(destination) == normalize(authoritative):
                continue

            try:
                if destination.exists():
                    current_hash = sha256_file(destination)

                    if current_hash == authoritative_hash:
                        continue

                LOG.info(
                    "Updating %s",
                    destination,
                )

                atomic_copy(
                    authoritative,
                    destination,
                )

            except Exception:
                LOG.exception(
                    "Failed updating %s",
                    destination,
                )

    def _conflict(
        self,
        mapping: Mapping,
        source: Path,
        mirror: Path,
    ):
        timestamp = time.strftime("%Y%m%d-%H%M%S")

        conflict_root = self.conflict_dir / mapping.attachment_key / timestamp

        conflict_root.mkdir(
            parents=True,
            exist_ok=True,
        )

        source_backup = conflict_root / f"zotero-{source.name}"

        mirror_backup = conflict_root / f"mirror-{mirror.name}"

        shutil.copy2(source, source_backup)
        shutil.copy2(mirror, mirror_backup)

        LOG.error(
            "CONFLICT for attachment %s. Both versions preserved in %s",
            mapping.attachment_key,
            conflict_root,
        )

        # Deliberately do not overwrite either side.
        #
        # This requires manual resolution, which is much safer than silently
        # discarding annotations.

    def _get_attachment_lock(
        self,
        attachment_key: str,
    ) -> threading.Lock:
        with self.lock:
            if attachment_key not in self.attachment_locks:
                self.attachment_locks[attachment_key] = threading.Lock()

            return self.attachment_locks[attachment_key]


def normalize(path: Path) -> Path:
    return Path(os.path.abspath(os.path.expanduser(str(path))))


def is_pdf(path: Path) -> bool:
    return path.suffix.lower() == ".pdf"


def remove_empty_mirror_directories(mirror_root: Path) -> int:
    """
    Remove directories under mirror_root that contain no PDFs.

    Directories are processed bottom-up, so if:

        Parent/
            Child/

    contains no PDFs, Child is removed first and then Parent.

    The mirror root itself is never removed.
    Hidden directories (e.g. .zotero-pdf-conflicts) are preserved.
    """
    mirror_root = normalize(mirror_root)
    removed = 0

    if not mirror_root.is_dir():
        return 0

    # Bottom-up traversal is important for nested Zotero collections.
    for root, dirs, files in os.walk(mirror_root, topdown=False):
        directory = Path(root)

        if directory == mirror_root:
            continue

        # Don't touch watcher/internal directories.
        if directory.name.startswith("."):
            continue

        # Does this directory tree still contain a PDF?
        has_pdf = any(path.is_file() and is_pdf(path) for path in directory.rglob("*"))

        if has_pdf:
            continue

        try:
            shutil.rmtree(directory)
            LOG.info("Removed empty mirror directory: %s", directory)
            removed += 1
        except FileNotFoundError:
            pass
        except OSError:
            LOG.exception(
                "Failed removing empty mirror directory: %s",
                directory,
            )

    return removed


def sha256_file(
    path: Path,
    chunk_size: int = 1024 * 1024,
) -> str:
    h = hashlib.sha256()

    with path.open("rb") as f:
        while True:
            chunk = f.read(chunk_size)

            if not chunk:
                break

            h.update(chunk)

    return h.hexdigest()


def wait_until_stable(
    path: Path,
    checks: int = 3,
    interval: float = 0.4,
) -> bool:
    """
    Wait until size + mtime stop changing.

    Useful when Syncthing or another process has generated a filesystem
    notification before it has completely finished writing/replacing a PDF.
    """

    previous = None
    stable_count = 0

    for _ in range(15):
        try:
            stat = path.stat()
        except FileNotFoundError:
            time.sleep(interval)
            continue

        current = (
            stat.st_size,
            stat.st_mtime_ns,
        )

        if current == previous:
            stable_count += 1

            if stable_count >= checks:
                return True
        else:
            stable_count = 0
            previous = current

        time.sleep(interval)

    return False


def atomic_copy(
    source: Path,
    destination: Path,
):
    source = normalize(source)
    destination = normalize(destination)

    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    # Temporary file must be in the destination directory so os.replace()
    # remains an atomic filesystem operation.
    fd, temp_name = tempfile.mkstemp(
        prefix=f".{destination.name}.sync-",
        dir=destination.parent,
    )

    os.close(fd)
    temp = Path(temp_name)

    try:
        shutil.copy2(source, temp)

        # Ensure contents have reached the filesystem before replacement.
        with temp.open("rb") as f:
            os.fsync(f.fileno())

        os.replace(temp, destination)

    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def atomic_write_json(
    destination: Path,
    data: dict,
):
    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    fd, temp_name = tempfile.mkstemp(
        prefix=f".{destination.name}.tmp-",
        dir=destination.parent,
        text=True,
    )

    temp = Path(temp_name)

    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(
                data,
                f,
                indent=2,
                sort_keys=True,
            )
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())

        os.replace(temp, destination)

    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def initialize_state(
    manifest: ManifestIndex,
    state: SyncState,
):
    """
    Establish baseline hashes without copying anything.

    Important on first startup: without a baseline, we cannot know whether
    a differing mirror file or Zotero file represents a later edit.
    """

    manifest.reload_if_needed(force=True)

    initialized = 0

    for mapping in manifest.by_source.values():
        if state.get(mapping.attachment_key):
            continue

        if not mapping.source.exists():
            continue

        source_hash = sha256_file(mapping.source)

        # Only establish a synchronized baseline if all existing mirror
        # copies agree with Zotero.
        differing = False

        for destination in mapping.destinations:
            if destination.exists() and sha256_file(destination) != source_hash:
                differing = True
                break

        if differing:
            LOG.warning(
                "Not initializing state for %s: mirror and Zotero already differ",
                mapping.attachment_key,
            )
            continue

        state.set(
            mapping.attachment_key,
            source_hash,
        )

        initialized += 1

    LOG.info(
        "Initialized %d attachment states",
        initialized,
    )


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Bidirectionally synchronize Zotero attachment PDFs "
            "with a collection mirror."
        )
    )

    parser.add_argument(
        "--storage",
        required=True,
        type=Path,
        help="Zotero storage directory",
    )

    parser.add_argument(
        "--mirror",
        required=True,
        type=Path,
        help="Generated collection mirror root",
    )

    parser.add_argument(
        "--manifest",
        type=Path,
        help=(
            "Manifest generated by ZoteroMirror. "
            "Defaults to MIRROR/.zotero-mirror-manifest.json"
        ),
    )

    parser.add_argument(
        "--state",
        type=Path,
        help=("Watcher state file. Defaults to MIRROR/.zotero-pdf-sync-state.json"),
    )

    parser.add_argument(
        "--conflicts",
        type=Path,
        help=("Conflict backup directory. Defaults to MIRROR/.zotero-pdf-conflicts"),
    )

    parser.add_argument(
        "--debounce",
        type=float,
        default=1.5,
        help="Filesystem event debounce in seconds",
    )

    parser.add_argument(
        "--verbose",
        action="store_true",
    )

    args = parser.parse_args()

    storage = normalize(args.storage)
    mirror = normalize(args.mirror)

    manifest_path = normalize(args.manifest or mirror / ".zotero-mirror-manifest.json")

    state_path = normalize(args.state or mirror / ".zotero-pdf-sync-state.json")

    conflict_dir = normalize(args.conflicts or mirror / ".zotero-pdf-conflicts")

    logging.basicConfig(
        level=(logging.DEBUG if args.verbose else logging.INFO),
        format=("%(asctime)s %(levelname)s %(message)s"),
    )

    LOG.info("Zotero storage: %s", storage)
    LOG.info("Mirror:         %s", mirror)
    LOG.info("Manifest:       %s", manifest_path)
    LOG.info("State:          %s", state_path)
    LOG.info("Conflicts:      %s", conflict_dir)

    manifest = ManifestIndex(manifest_path)

    if not manifest.reload_if_needed(force=True):
        raise SystemExit(f"Cannot load manifest: {manifest_path}")

    state = SyncState(state_path)

    initialize_state(
        manifest,
        state,
    )

    synchronizer = ZoteroPDFSync(
        manifest,
        state,
        conflict_dir,
    )

    debouncer = Debouncer(
        args.debounce,
        synchronizer.process,
    )

    handler = PDFEventHandler(debouncer)

    observer = Observer()

    observer.schedule(
        handler,
        str(storage),
        recursive=True,
    )

    observer.schedule(
        handler,
        str(mirror),
        recursive=True,
    )

    observer.start()

    LOG.info("Watching for PDF changes")

    stop_event = threading.Event()

    def stop(*_):
        stop_event.set()

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    try:
        while not stop_event.wait(1):
            # Pick up structural changes made by the Zotero extension even
            # when no PDF event occurs.
            manifest_changed = manifest.reload_if_needed()

            if manifest_changed:
                removed = remove_empty_mirror_directories(mirror)

                if removed:
                    LOG.info(
                        "Removed %d empty mirror director%s",
                        removed,
                        "y" if removed == 1 else "ies",
                    )

    finally:
        LOG.info("Stopping")
        observer.stop()
        observer.join()


if __name__ == "__main__":
    main()

# vim:filetype=python
