#!/usr/bin/env bash
# Usage: open_document [--check] NAME [PAGE]
#   --check  don't open anything: exit 0 if NAME (and PAGE) can be
#            opened, otherwise print why on stdout and exit 1.

CHECK=false
if [[ "$1" == "--check" ]]; then
	CHECK=true
	shift
fi

DOC_NAME="$1"
PAGE_NUM="$2"

PATHS_TO_SEARCH=("${HOME}" "${XDG_CONFIG_HOME}/Zotero/storage")

[[ -f "$DOC_NAME" ]] && DOC_PATH="$DOC_NAME" || DOC_PATH="$(fd --no-ignore-vcs -F "${DOC_NAME}" "${PATHS_TO_SEARCH[@]}" 2>/dev/null | head -1)"

if $CHECK; then
	if [[ -z "$DOC_PATH" || ! -e "$DOC_PATH" ]]; then
		echo "not found"
		exit 1
	fi
	if [[ "$PAGE_NUM" =~ ^[0-9]+$ && "${DOC_PATH,,}" == *.pdf ]] && command -v pdfinfo >/dev/null; then
		pages=$(pdfinfo "$DOC_PATH" 2>/dev/null | awk '/^Pages:/ {print $2}')
		if [[ -n "$pages" ]] && ((PAGE_NUM < 1 || PAGE_NUM > pages)); then
			echo "no page $PAGE_NUM (has $pages)"
			exit 1
		fi
	fi
	exit 0
fi

FILETYPE=$(xdg-mime query filetype "$DOC_PATH")
APPLICATION=$(xdg-mime query default "$FILETYPE")

if [[ "$APPLICATION" == "zathura.desktop" ]]; then
	fasd -A "${DOC_PATH}" # Add it for frecency
	CMD="zathura ${DOC_PATH@Q}"
	if [[ -n "$PAGE_NUM" ]]; then
		CMD+=" -P $PAGE_NUM"
	fi
fi

old_pids=$(pgrep -x zathura || true)
bash -ic "$CMD"

# Wait until new zathura process opens
while :; do
	current_pids=$(pgrep -x zathura || true)
	new_pid=$(comm -13 <(echo "$old_pids" | sort) <(echo "$current_pids" | sort))
	[[ -n "$new_pid" ]] && break
	sleep 0.05
done

if ! <"$XDG_CONFIG_HOME/i3/focus_on_window_activation_config" grep -q 'none'; then
	while :; do
		# Wait until the DM registers the window
		win_id=$(i3-msg -t get_tree | jq -r --arg pid "$new_pid" '
    .. | objects
    | select(.pid == ($pid|tonumber))
    | .id
    ')

		[[ -n "$win_id" ]] && break
		sleep 0.05
	done
	swaymsg "[con_id=$win_id]" focus
fi
