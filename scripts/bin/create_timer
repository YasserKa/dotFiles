#!/usr/bin/env bash
#######################################
# Create a countdown timer
# Arguments:
#   $1: seconds to wait, a duration like 1h, 45m, 1h30m, 90s,
#       OR a target time in HH:MM format
#       (HH:MM is interpreted as the next occurrence of that
#        clock time, today or tomorrow if it has already passed)
#   $2: (optional) message
#######################################

# Only emit color/cursor codes when writing to a real terminal
if [ -t 1 ]; then
	readonly IS_TTY=1
	readonly COLOR_RESET=$(tput sgr0)
	readonly COLOR_BOLD=$(tput bold)
	readonly COLOR_CYAN=$(tput setaf 6)
	readonly COLOR_YELLOW=$(tput setaf 3)
else
	readonly IS_TTY=0
	readonly COLOR_RESET=""
	readonly COLOR_BOLD=""
	readonly COLOR_CYAN=""
	readonly COLOR_YELLOW=""
fi

STARTED=0
cleanup() {
	# Move off the countdown line so the prompt doesn't overwrite it
	((STARTED)) && echo
	((IS_TTY)) && tput cnorm
}

# Format seconds as MM:SS, or HH:MM:SS when an hour or more (hours not capped at 24)
get_time() {
	local -r S="$1"
	local -r H=$((S / 3600)) M=$((S % 3600 / 60)) SEC=$((S % 60))
	if ((H > 0)); then
		printf '%02d:%02d:%02d' "$H" "$M" "$SEC"
	else
		printf '%02d:%02d' "$M" "$SEC"
	fi
}

# Convert an HH:MM target time, or a duration like 1h, 45m, 1h30m, 90s,
# into seconds. A plain integer is treated as raw seconds.
resolve_seconds() {
	local -r INPUT="$1"
	if [[ "$INPUT" =~ ^([0-1]?[0-9]|2[0-3]):([0-5][0-9])$ ]]; then
		local -r NOW_EPOCH=$(date +%s)
		local TARGET_EPOCH
		TARGET_EPOCH=$(date -d "$INPUT" +%s) || {
			echo "Invalid time: $INPUT" >&2
			exit 1
		}
		# If that time already passed today, target tomorrow instead
		if ((TARGET_EPOCH <= NOW_EPOCH)); then
			TARGET_EPOCH=$(date -d "tomorrow $INPUT" +%s)
		fi
		echo $((TARGET_EPOCH - NOW_EPOCH))
	elif [[ -n "$INPUT" && "$INPUT" =~ ^(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?$ ]]; then
		# 10# forces base 10 so inputs like "08m" aren't parsed as octal
		echo $((10#${BASH_REMATCH[2]:-0} * 3600 + 10#${BASH_REMATCH[4]:-0} * 60 + 10#${BASH_REMATCH[6]:-0}))
	elif [[ "$INPUT" =~ ^[0-9]+$ ]]; then
		echo $((10#$INPUT))
	else
		echo "Invalid duration: $INPUT (use seconds, 1h, 45m, 1h30m, 90s or HH:MM)" >&2
		exit 1
	fi
}

print_status() {
	local -r LEFT="$1" TOTAL="$2"
	echo -ne "Left: ${COLOR_YELLOW}${COLOR_BOLD}$(get_time "$LEFT")${COLOR_RESET}  Elapsed: $(get_time "$((TOTAL - LEFT))")\033[0K\r"
}

main() {
	local -r TOTAL="$1"
	local -r MESSAGE="${2:-TIMER UP!}"
	# Fixed end time: avoids drift from loop overhead and survives suspend
	local -r END_EPOCH=$(($(date +%s) + TOTAL))
	local LEFT="$TOTAL"

	echo -e "${COLOR_BOLD}${COLOR_CYAN}Interval:${COLOR_RESET} $(date +%H:%M) -> $(date -d "@$END_EPOCH" +%H:%M)  ($(get_time "$TOTAL"))\n"

	STARTED=1
	((IS_TTY)) && tput civis
	while ((LEFT > 0)); do
		print_status "$LEFT" "$TOTAL"
		sleep 1
		LEFT=$((END_EPOCH - $(date +%s)))
	done
	print_status 0 "$TOTAL"
	notify-send --expire-time=$((5 * 60 * 1000)) -- "$MESSAGE"
}

trap cleanup EXIT

if (($# > 2)); then
	echo "One needed option - seconds or HH:MM, and optionally message" && exit 1
fi

TOTAL_ARG="$(resolve_seconds "$1")" || exit 1
main "$TOTAL_ARG" "$2"
