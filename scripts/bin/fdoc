#!/usr/bin/env bash
#
# Open documents
#
# Dependencies: fasd fd fzf
# Paths to search for documents
# REASON: It's slow to search all directories (including hidden)
declare -a PATHS_TO_SEARCH
# TODO: if this changes, zotero's link handler should be changed as well. Try to
# resolve this duplication
PATHS_TO_SEARCH=("${HOME}")
readonly PATHS_TO_SEARCH
################################################################################
# Get basename for documents in PATHS_TO_SEARCH by using a regex on their
# extensions. Place priority on documents using fasd (frecency) (i.e. frequency
# and recently opened)
# Globals:
#     PATHS_TO_SEARCH
# Arguments:
#     None
# Outputs:
#     file names for documents seperated by new line
################################################################################

get_documents() {
	local DOCS_PATH FASD_DOCS
	DOCS_PATH="$(fd --no-ignore --regex '\.(pdf|djvu|epub)$' "${PATHS_TO_SEARCH[@]}")"
	FASD_DOCS="$(fasd -flR | grep -Fx -f <(printf '%s\n' "$DOCS_PATH"))"
	printf '%s\n' "$FASD_DOCS"
	printf '%s\n' "$DOCS_PATH" | grep -Fvx -f <(printf '%s\n' "$FASD_DOCS")
}

main() {
	local DOC_SELECTED LIST_FILE TMP_FILE
	LIST_FILE="$(mktemp -t "fdoc_list_XXX")"
	TMP_FILE="$(mktemp -t "fdoc_sel_XXX")"
	trap 'rm -f "$LIST_FILE" "$TMP_FILE"' EXIT

	get_documents | awk -F'\t' '
BEGIN { home = ENVIRON["HOME"] "/"; g = "\033[32m"; r = "\033[0m" }
{
    full = $0
    rel = (index(full, home) == 1) ? substr(full, length(home) + 1) : full
    n = split(full, p, "/")
    short = p[n-1] "/" g p[n] r
    match(rel, /[^\/]*$/)
    fromhome = substr(rel, 1, RSTART - 1) g substr(rel, RSTART) r
    printf "%s\t%s\t%s\n", full, short, fromhome
}' >|"$LIST_FILE"

	local cmd
	cmd="fzf --scheme=path --tiebreak=index --multi --delimiter '\t' --accept-nth 1 --with-nth 3 --ansi \
		--header 'ctrl-t: toggle path display' --bind 'ctrl-t:change-with-nth(2|3)' \
		--preview='\$XDG_CONFIG_HOME/fzf/fzf_preview_media {1}' \
		< $(printf '%q' "$LIST_FILE") >| $(printf '%q' "$TMP_FILE")"

	eval_interactive_cmd --floating --geometry 'fullscreen toggle' "$cmd"

	DOC_SELECTED="$(<"$TMP_FILE")"
	[[ -z "$DOC_SELECTED" ]] && exit 1
	while read -r DOC; do
		xdg-open "${DOC}" >/dev/null 2>&1 &
		disown
		fasd -A "${DOC}"
	done <<<"$DOC_SELECTED"
	i3-msg 'workspace --no-auto-back-and-forth 8'
}

main
