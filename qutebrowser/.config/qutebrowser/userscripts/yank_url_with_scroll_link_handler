#!/usr/bin/env bash
#
# qutebrowser userscript: yank an Org link to the current page that
# remembers the scroll position.
#
#   [[web:https://example.com/page.html::7100][Page title]]
#
# Open such links with open_webpage (via the "web" Org link type).
#
# Install: put this in ~/.local/share/qutebrowser/userscripts/ and bind it,
#   :bind yw spawn --userscript yank-web-link
#
# Dependencies: yq, clipboard_copy

set -u

fifo() { echo "$*" >>"$QUTE_FIFO"; }

# qutebrowser does not give userscripts the scroll position, so save a
# session (it records it) and read it back.
session_name="link_handler"
session_path="${QUTE_DATA_DIR}/sessions/${session_name}.yml"

old_mtime="$(date -r "$session_path" +%s%N 2>/dev/null || echo none)"

fifo ":session-save --quiet --only-active-window $session_name"

# Wait (at most ~3 s) for qutebrowser to write the new session, so we do not
# read the scroll position from an older save.
for _ in {1..60}; do
	new_mtime="$(date -r "$session_path" +%s%N 2>/dev/null || echo none)"
	[[ "$new_mtime" != none && "$new_mtime" != "$old_mtime" ]] && break
	sleep 0.05
done

# Active window (or the only one saved), active tab, current history entry.
y="$(yq '((.windows | map(select(.active == true))) + .windows) | .[0]
         | .tabs[] | select(.active == true)
         | .history[] | select(.active == true) | ."scroll-pos".y' "$session_path" 2>/dev/null |
	head -n 1)"
[[ "$y" =~ ^[0-9]+$ ]] || y=0

# Org links: brackets in the URL are percent-encoded (same URL), brackets in
# the description become braces, as org-store-link does.
url="${QUTE_URL//[/%5B}"
url="${url//]/%5D}"
title="${QUTE_TITLE:-$QUTE_URL}"
title="${title//[/\{}"
title="${title//]/\}}"

target="$url"
((y > 0)) && target+="::$y" || { ~/.config/qutebrowser/userscripts/yank_org_link && exit 0; }
link="[[web:${target}][${title}]]"

clipboard_copy "$link"

if ((y > 0)); then
	fifo "message-info 'Yanked web link at scroll $y'"
else
	fifo "message-info 'Yanked web link'"
fi
