#!/usr/bin/env bash
#
# Use org mode's clocking in emacs
# This is used by i3 and sway to trigger the functions and by polybar or waybar to present the output

# Dependencies: emacs, notify-send

# Path to the file that contains info about the entry
declare -r TMP_FILE_PATH="/tmp/org_current_task"
# Path to the file that contains flag to show clocked time in the bar
declare -r TMP_FILE_FLAG_PATH_BAR="${XDG_CACHE_HOME}/org_current_task_flag_bar"
# Path to the file that contains flag to show clocked time done today/total
declare -r TMP_FILE_FLAG_PATH_TODAY="${XDG_CACHE_HOME}/org_current_task_flag_today"

[[ ! -e "${TMP_FILE_FLAG_PATH_BAR}" ]] && echo 1 >"${TMP_FILE_FLAG_PATH_BAR}"
[[ ! -e "${TMP_FILE_FLAG_PATH_TODAY}" ]] && echo 0 >"${TMP_FILE_FLAG_PATH_TODAY}"

################################################################################
# Focus emacs window that's used for org mode and go to the clocked in entry
# Arguments:
#     None
################################################################################
source "$HOME/.bashrc.d/functions.bash"
go_to_entry() {
	# Focus window
	goto_window "^emacs_org$"
	execute_emacs_command "(org-clock-goto)"
}

################################################################################
# Focus emacs window that's used for org mode and go to the closest scheduled in entry
# Arguments:
#     None
################################################################################
go_to_scheduled_entry() {
	goto_window "^emacs_org$"
	# Go to clocked or most recently clocked entry
	execute_emacs_command "(my/org-goto-next-scheduled)"
}

################################################################################
# Toggle if the time for the clock should be shown or not
################################################################################
toggle_bar_time() {
	local -i OLD_FLAG
	OLD_FLAG="$(tail -n 1 "${TMP_FILE_FLAG_PATH_BAR}")"
	readonly OLD_FLAG
	local -i FLAG
	((OLD_FLAG == 0)) && FLAG=1 || FLAG=0
	readonly FLAG
	sed -i "\$s/${OLD_FLAG}/${FLAG}/" "${TMP_FILE_FLAG_PATH_BAR}"
}

################################################################################
# Toggle if the time for the clock should be shown or not
################################################################################
toggle_today_time() {
	local -i OLD_FLAG
	OLD_FLAG="$(tail -n 1 "${TMP_FILE_FLAG_PATH_TODAY}")"
	readonly OLD_FLAG
	local -i FLAG
	((OLD_FLAG == 0)) && FLAG=1 || FLAG=0
	readonly FLAG
	sed -i "\$s/${OLD_FLAG}/${FLAG}/" "${TMP_FILE_FLAG_PATH_TODAY}"
}

################################################################################
# Pop info regarding the entry
# Arguments:
#     $1: String containing TIME_PLACEHOLDER or/and NAME_PLACEHOLDER
#     $2: Flag for limiting what's returned
# Outputs:
#     Notification containing info
################################################################################
notify_info() {
	local INFO
	INFO="$(get_info "$1" "$2")"
	notify-send "$(echo -e "$INFO")"
}

################################################################################
# Transform a string filled with time or/and name placeholder to one that
# contains info
# Globals:
#     TMP_FILE_PATH
# Arguments:
#     $1: String containing TIME_PLACEHOLDER or/and NAME_PLACEHOLDER
#     $2: Flag for limiting what's returned
# Outputs:
#     String containing info
# Returns:
#     0: If TMP_FILE_PATH doesn't exit
################################################################################
get_info() {
	[[ ! -e "${TMP_FILE_PATH}" ]] && echo "${TMP_FILE_PATH} doesn't exist" && return 0

	local FILE_LINES
	FILE_LINES="$(head -3 $TMP_FILE_PATH | tail -1)"

	local INFO

	if [[ "$(cat "$TMP_FILE_FLAG_PATH_BAR")" == 1 ]] || [[ "$2" == 1 ]]; then
		local TIME
		TIME="$(get_time "${FILE_LINES}")"

		INFO="${1/TIME_PLACEHOLDER/${TIME}}"
	fi
	local NAME
	NAME="$(get_name "${FILE_LINES}")"

	INFO="${INFO/NAME_PLACEHOLDER/${NAME}}"

	echo "${INFO:- }"
}

################################################################################
# Get name of the entry and caping the length to NAME_MAX_SIZE chars
# Arguments:
#     $1: file lines that from temp file
# Outputs:
#     Name of entry that might end with '...' if it goes beyond the cap
################################################################################
get_name() {
	local -ir NAME_MAX_SIZE=52

	TASK_NAME="$(cut -d ' ' -f 2- <(echo "$1"))"

	# Limit the size of information to not overwhelm the bar when the string is too big
	[[ ${#TASK_NAME} -gt $NAME_MAX_SIZE ]] && TASK_NAME=${TASK_NAME:0:NAME_MAX_SIZE}"...)"
	echo "$TASK_NAME"
}

#######################################
# Turn Dd HH:MM time format to seconds
# Arguments:
#   $1: Time format in Dd HH:MM
#######################################
to_seconds() {
	local s=$1
	if [[ $s =~ ^(([0-9]+)d[[:space:]]+)?([0-9]+):([0-9]+)$ ]]; then
		local d=${BASH_REMATCH[2]:-0}
		local h=${BASH_REMATCH[3]}
		local m=${BASH_REMATCH[4]}
		echo $((10#$d * 86400 + 10#$h * 3600 + 10#$m * 60))
	else
		echo "Invalid format: $s" >&2
		return 1
	fi
}

#######################################
# Turn seconds to Dd HH:MM time format
# Arguments:
#   $1: Time format in seconds
#######################################
from_seconds() {
	local total=$1
	local d=$((total / 86400))
	local h=$(((total % 86400) / 3600))
	local m=$(((total % 3600) / 60))

	if ((d > 0)); then
		printf '%dd %02d:%02d\n' "$d" "$h" "$m"
	else
		printf '%02d:%02d\n' "$h" "$m"
	fi
}

################################################################################
# Return the time needed/time spent or only time spent (if time needed doesn't
# exist) in H:MM/H:MM format
# Arguments:
#     $1: file lines that from temp file
# Outputs:
#     Time for the entry
################################################################################
get_time() {
	local TASK_TIME
	# Time format in [Dd HH:MM], or [Dd HH:MM/Dd HH:MM] (if effort provided)
	TASK_TIME="$(echo "$1" | sed -E 's/^(\[[^]]*\]).*/\1/')"

	# Seconds since the temp file got created
	local -i SESSION_SECONDS=$(($(date +%s) - $(date +%s -r $TMP_FILE_PATH)))
	# HH:MM format
	SESSION_TIME=$(date --date="@$SESSION_SECONDS" -u +%H:%M)

	# Add time spent
	TODAY_SECONDS="$(($(head -4 $TMP_FILE_PATH | tail -1) * 60))"

	# Today time
	TOTAL_TODAY_SECONDS=$((SESSION_SECONDS + TODAY_SECONDS))
	TOTA_TODAY_TIME=$(date --date="@$TOTAL_TODAY_SECONDS" -u +%H:%M)

	# Total time
	# Get [<time_already_spent>/<effort> (optional)]
	TIME_TOTAL="$(sed -E 's/.*\[([^]/]+).*/\1/' <(echo "$TASK_TIME"))"
	# Add today's time
	SECONDS_TOTAL="$(to_seconds "$TIME_TOTAL")"
	SECONDS_TOTAL="$((SECONDS_TOTAL + SESSION_SECONDS))"
	# Convert it back to Dd HH:MM
	TIME_TOTAL="$(from_seconds "$SECONDS_TOTAL")"

	# Get [<time_already_spent>/<effort>]
	EFFORT="$(sed -n 's|.*\/\(.*\)\]|\1|p' <(echo "$TASK_TIME"))"
	# Add time needed if it exists (Effort might not exist for a task)
	if [[ $EFFORT != "" ]]; then
		TIME_TOTAL="$TIME_TOTAL/$EFFORT"
	fi

	if [[ -n "${WAYLAND_DISPLAY}" ]]; then
		echo "<span alpha=\"60%\">${TOTA_TODAY_TIME}</span> · <b>${SESSION_TIME}</b> | <span alpha=\"70%\">${TIME_TOTAL}</span>"
	else
		echo "${TOTA_TODAY_TIME} · ${SESSION_TIME} | ${TIME_TOTAL}"
	fi
}

execute_emacs_command() {
	emacsclient --socket-name="$EMACS_ORG_SOCKET" -e "$@"
}

main() {
	case "$1" in
		"clock_in") execute_emacs_command "(org-clock-in-last)" ;;
		"clock_out") execute_emacs_command "(org-clock-out)" ;;
		"clock_out_done") execute_emacs_command "(my/org-clock-out-done)" ;;
		"clock_toggle") execute_emacs_command "(my/org-toggle-last-clock nil)" ;;
		"clock_cancel") execute_emacs_command "(org-clock-cancel)" ;;
		"go_to_entry") go_to_entry ;;
		"go_to_scheduled_entry") go_to_scheduled_entry ;;
		"get_info") get_info "$2" 0 ;;
		"notify_info") notify_info "$2" 1 ;;
		"toggle_bar_time") toggle_bar_time ;;
		"toggle_today_time") toggle_today_time ;;
		*) echo "$1 is a wrong argument" ;;
	esac
}

main "$@"
