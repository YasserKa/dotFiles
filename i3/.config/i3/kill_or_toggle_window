#!/usr/bin/env bash
# Move an app's main window to the scratchpad; kill everything else.
# dependencies: sway (or i3), jq

# Pairs of: app_id/class regex   title regex identifying the MAIN window
rules=(
    '^Zotero$' 'Zotero'
    '^(org\.mozilla\.Thunderbird|thunderbird)$' 'Mozilla Thunderbird$'
)

IFS=$'\t' read -r id app title < <(
    i3-msg -t get_tree | jq -r '
        .. | objects | select(.focused == true and .type != "workspace")
        | [.id, (.app_id // .window_properties.class // ""), (.name // "")]
        | @tsv'
)

[[ -z "$id" ]] && exit 0 # nothing focused (e.g. empty workspace)

for ((i = 0; i < ${#rules[@]}; i += 2)); do
    app_re=${rules[i]} main_re=${rules[i + 1]}
    if [[ $app =~ $app_re ]]; then
        if [[ $title =~ $main_re ]]; then
            # Sway needs fullscreen disabled first, otherwise it bugs out
            i3-msg "[con_id=$id] fullscreen disable, move scratchpad"
            exit 0
        fi
        break # known app, but a secondary window -> kill it
    fi
done

i3-msg "[con_id=$id] kill"
